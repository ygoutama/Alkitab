 "verses": {
  "GEN": {
   "1": [
    {
     "verse": 1,
     "id": "Pada mulanya, Allah menciptakan langit dan bumi.",
     "en": "In the beginning God created the heavens and the earth.",
     "orig": "בְּרֵאשִׁית בָּרָא אֱלֹהִים אֵת הַשָּׁמַיִם וְאֵת הָאָרֶץ׃",
     "trans": "Bereshit bara Elohim et hashamayim ve'et ha'aretz."
    },
    {
     "verse": 2,
     "id": "Bumi belum berbentuk dan kosong; kegelapan menutupi samudra raya, dan Roh Allah melayang-layang di atas permukaan air.",
     "en": "Now the earth was formless and void, and darkness was over the surface of the deep. And the Spirit of God was hovering over the surface of the waters.",
     "orig": "וְהָאָרֶץ הָיְתָה תֹהוּ וָבֹהוּ וְחֹשֶׁךְ עַל־פְּנֵי תְהוֹם וְרוּחַ אֱלֹהִים מְרַחֶפֶת עַל־פְּנֵי הַמָּיִם׃",
     "trans": "Veha'aretz hayetah tohu vavohu vechoshech al-penei tehom veruach Elohim merachefet al-penei hamayim."
    },
    {
     "verse": 3,
     "id": "Allah berfirman, 'Jadilah terang.' Lalu terang itu jadi.",
     "en": "And God said, 'Let there be light,' and there was light.",
     "orig": "וַיֹּאמֶר אֱלֹהִים יְהִי אוֹר וַיְהִי־אוֹר׃",
     "trans": "Vayomer Elohim yehi or vayehi-or."
    }
   ]
  },
  "JOHN": {
   "1": [
    {
     "verse": 1,
     "id": "Pada mulanya adalah Firman; Firman itu bersama-sama dengan Allah dan Firman itu adalah Allah.",
     "en": "In the beginning was the Word, and the Word was with God, and the Word was God.",
     "orig": "Ἐν ἀρχῇ ἦν ὁ Λόγος, καὶ ὁ Λόγος ἦν πρὸς τὸν Θεόν, καὶ Θεὸς ἦν ὁ Λόγος.",
     "trans": "En arche en ho Logos, kai ho Logos en pros ton Theon, kai Theos en ho Logos."
    },
    {
     "verse": 2,
     "id": "Ia pada mulanya bersama-sama dengan Allah.",
     "en": "He was with God in the beginning.",
     "orig": "οὗτος ἦν ἐν ἀρχῇ πρὸς τὸν Θεόν.",
     "trans": "Houtos en en arche pros ton Theon."
    }
   ]
  }
 }
